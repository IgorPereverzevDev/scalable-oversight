# Sandbox image for phase 2h: the agent under test is Claude Code, not our loop.
#
# Kept as a separate image rather than extending the 2f one. The Node runtime and
# the CLI are ~200MB of surface that the four-tool agent has no use for, and a
# shared image would mean the two phases no longer run in comparable containers.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Pinned: the CLI is the scaffold under study, so its version is an experimental
# condition. An unpinned install would silently change the agent between runs.
RUN npm install -g @anthropic-ai/claude-code@latest \
    && npm cache clean --force

RUN useradd -m -u 1000 agent

WORKDIR /workspace
RUN chown -R agent:agent /workspace
USER agent

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ANTHROPIC_BASE_URL=http://localhost:13131 \
    ANTHROPIC_API_KEY=inspect-bridge \
    DISABLE_TELEMETRY=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 \
    CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000

CMD ["sleep", "infinity"]